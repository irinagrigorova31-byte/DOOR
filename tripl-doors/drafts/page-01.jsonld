      "@type": "FAQPage",
      "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/vhodnye-dveri/#faq",
      "isPartOf": { "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/vhodnye-dveri/" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли ставить как входную дешёвую дверь за 6 000 рублей?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Дверь за такие деньги — это тонкий металл и лёгкий наполнитель, её место в подсобке или техпомещении. Как входная в квартиру или дом она не держит ни тепло, ни взлом, а фурнитура быстро выходит из строя. Для входа берите дверь с честной толщиной стали и нормальными замками."
          }
        },
        {
          "@type": "Question",
          "name": "Делаете ли двери по нестандартным размерам и за какой срок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, изготовление по индивидуальным размерам — большая часть нашей работы, делаем практически любые размеры. Срок изготовления — от 2 суток, если заказ срочный."
          }
        }
      ]
    }
