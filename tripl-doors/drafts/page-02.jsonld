    {
      "@type": "FAQPage",
      "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/dveri-dlya-doma-ili-kvartiry/#faq",
      "isPartOf": { "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/dveri-dlya-doma-ili-kvartiry/" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Промерзает ли входная дверь без терморазрыва в частном доме?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На входе с улицы — да, может: без терморазрыва по полотну идёт мостик холода, дверь промерзает и на ней выступает конденсат. Для частного дома, дачи и отдельного входа берите дверь с терморазрывом; в отапливаемый тамбур или подъезд он не нужен."
          }
        },
        {
          "@type": "Question",
          "name": "Делаете ли двери по нестандартным размерам для дома и за какой срок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, изготовление по индивидуальным размерам — большая часть нашей работы, делаем практически любые размеры под проём. Срок изготовления — от 2 суток, если заказ срочный."
          }
        },
        {
          "@type": "Question",
          "name": "Кто отвечает за дверь по гарантии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Гарантию на дверь даёт изготовитель — завод «Сталь-Плюс». Замер и установку выполняет наша бригада, поэтому мы отвечаем и за саму дверь, и за монтаж, а не отсылаем вас к сторонним мастерам."
          }
        }
      ]
    }
  ]
