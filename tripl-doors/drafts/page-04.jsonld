    {
      "@type": "FAQPage",
      "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/dveri-protivopozharnye-metallicheskie/#faq",
      "isPartOf": { "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/dveri-protivopozharnye-metallicheskie/" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как понять, что дверь действительно противопожарная?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На настоящей противопожарной двери есть маркировочная шильда с классом огнестойкости и данными завода, а у продавца есть сертификат на эту продукцию. Наши двери ДПМ подтверждены сертификатами ЕАЭС RU C-RU.НЕ25.В.00065/25 и по ГОСТ Р 57327-2016. Без сертификата дверь не считается противопожарной и не пройдёт пожарную проверку."
          }
        },
        {
          "@type": "Question",
          "name": "Делаете ли противопожарные двери по нестандартным размерам?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, изготавливаем ДПМ по размерам проёма: ширина от 800 до 2200 мм, высота от 1900 до 3250 мм. Это удобно для нестандартных проёмов в квартире, офисе и техпомещении. Тип и размер уточняем на замере."
          }
        },
        {
          "@type": "Question",
          "name": "Кто отвечает по гарантии и делаете ли вы монтаж?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Гарантию на дверь даёт изготовитель, завод «Сталь-Плюс». Замер и установку выполняет наша бригада, поэтому мы отвечаем и за саму дверь, и за монтаж, а не отсылаем вас к сторонним мастерам."
          }
        }
      ]
    }
