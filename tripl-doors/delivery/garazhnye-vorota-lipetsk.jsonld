    {
      "@type": "FAQPage",
      "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/garazhnye-vorota/#faq",
      "isPartOf": { "@id": "https://xn-----6kcibbkcblan1b0ckd4b8ed3j.xn--p1ai/product-category/garazhnye-vorota/" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Делаете ли гаражные ворота по нестандартным размерам проёма?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, изготовление ворот по размерам проёма — основа нашей работы: сначала замеряем проём гаража, затем варим ворота под него, чтобы они встали без щелей и подгонки. Практически любые размеры под ваш гараж."
          }
        },
        {
          "@type": "Question",
          "name": "Ставите ли калитку в воротах?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, варим ворота как с калиткой, так и без неё — сертификат на ворота покрывает оба варианта. Калитка позволяет заходить в гараж, не открывая тяжёлые створки; сторону и размер калитки уточняем на замере."
          }
        },
        {
          "@type": "Question",
          "name": "Кто отвечает за ворота по гарантии и делаете ли вы монтаж?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Гарантию на ворота даёт изготовитель — завод «Сталь-Плюс». Замер и установку выполняет наша бригада, поэтому мы отвечаем и за сами ворота, и за монтаж, а не отсылаем вас к сторонним мастерам."
          }
        }
      ]
    }
